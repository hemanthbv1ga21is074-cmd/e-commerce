# StyleBazaar Fashion Storefront Configuration

# Backend API Mode
# Set to 'true' for standalone client-side mock data layer (no backend required)
# Set to 'false' to connect to the real backend at VITE_API_BASE_URL
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:4000/api

# Payment Gateway (Razorpay)
# For sandbox testing, set your Razorpay Test Key ID (rzp_test_...)
# Leave blank or mock prefix to run in automatic interactive simulation mode
VITE_RAZORPAY_KEY_ID=rzp_test_mock_stylebazaar

# Brand & Storefront Customization
VITE_BRAND_NAME=StyleBazaar
VITE_CURRENCY=INR
VITE_DEFAULT_PINCODE=560001
