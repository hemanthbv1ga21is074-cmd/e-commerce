# Server Environment Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database (PostgreSQL)
# For Docker Compose: postgresql://stylebazaar_user:stylebazaar_secure_password_2026@localhost:5432/stylebazaar_db?schema=public
# For Local Embedded Postgres (pglite-server): postgresql://postgres:postgres@localhost:5432/stylebazaar?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stylebazaar?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="stylebazaar_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="stylebazaar_jwt_refresh_secret_super_secure_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Feature Flags (All Default to false)
AUTH_PHONE_OTP_ENABLED=false
ONLINE_PAYMENTS_ENABLED=false

# COD Abuse Controls & Thresholds (in Paise)
COD_ENABLED=true
COD_MAX_ORDER_VALUE_PAISE=500000
COD_FEE_PAISE=5000
MAX_UNCONFIRMED_COD_PER_USER=3
FREE_DELIVERY_THRESHOLD_PAISE=99900
STANDARD_DELIVERY_FEE_PAISE=9900

# Email Provider Configuration (resend | ses | dev)
EMAIL_PROVIDER=dev
RESEND_API_KEY=""
EMAIL_FROM="StyleBazaar <orders@stylebazaar.local>"

# SMS Provider (dev stub only; no live SMS flow in Phase 5)
SMS_PROVIDER=dev

# Image Storage Provider (local | cloudinary | s3)
STORAGE_PROVIDER=local
