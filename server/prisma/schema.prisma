datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  KIDS
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_PICKED_UP
  RETURN_RECEIVED
  REFUNDED
}

enum PaymentProviderType {
  COD
  WALLET
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  COD_PENDING
  COD_COLLECTED
  SUCCESS
  FAILED
  REFUNDED
}

enum WalletLedgerType {
  CREDIT
  DEBIT
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKED_UP
  RECEIVED
  REJECTED
  COMPLETED
}

// ==========================================
// 1. Users, Auth & Access Control
// ==========================================

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  phone          String?
  gender         String?
  birthday       DateTime?
  alternatePhone String?
  avatarUrl      String?
  role           Role      @default(CUSTOMER)
  
  isEmailVerified Boolean   @default(false)
  isCodBlocked    Boolean   @default(false)
  unconfirmedCodOrdersCount Int @default(0)

  walletBalanceInPaise Int    @default(0)
  loyaltyPoints        Int    @default(0)
  loyaltyTier          String @default("Silver") // Silver, Gold, Platinum

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  emailTokens            EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  addresses              Address[]
  orders                 Order[]
  cart                   Cart?
  wishlist               Wishlist?
  walletLedger           WalletLedgerEntry[]
  loyaltyLedger          LoyaltyLedgerEntry[]
  reviews                Review[]
  reviewVotes            ReviewHelpfulVote[]
  auditLogs              AuditLog[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  pincode      String
  city         String
  state        String
  locality     String
  addressLine1 String
  addressLine2 String?
  type         String   @default("Home") // Home | Work
  isDefault    Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@index([pincode])
}

// ==========================================
// 2. Catalog: Brands, Categories, Products
// ==========================================

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  tagline   String?
  logoUrl   String?
  gradient  String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  label       String
  slug        String     @unique
  gender      Gender?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([gender])
}

model Product {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  description         String
  gender              Gender
  categoryPath        String[] // ["Men", "Topwear", "T-Shirts"]
  
  brandId             String
  brand               Brand    @relation(fields: [brandId], references: [id])
  
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])

  mrpInPaise          Int
  priceInPaise        Int
  discountPercent     Int

  fabric              String
  fit                 String
  pattern             String
  occasion            String[]
  highlights          String[]
  careInstructions    String[]
  deliveryEstimateDays Int     @default(4)
  returnWindowDays    Int      @default(30)
  tags                String[]

  rating              Float    @default(0)
  ratingCount         Int      @default(0)

  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  variants            ProductVariant[]
  images              ProductImage[]
  reviews             Review[]
  orderItems          OrderItem[]
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]

  @@index([slug])
  @@index([gender])
  @@index([brandId])
  @@index([priceInPaise])
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode      String   @unique
  size         String   // S, M, L, XL, 30, 32...
  colorName    String
  colorHex     String
  stock        Int      @default(0)
  reservedStock Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations InventoryReservation[]
  orderItems   OrderItem[]
  cartItems    CartItem[]

  @@unique([productId, size, colorName])
  @@index([productId])
  @@index([skuCode])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model PincodeServiceability {
  pincode       String   @id
  city          String
  state         String
  estimatedDays Int      @default(5)
  codAvailable  Boolean  @default(true)
  isBlocked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pincode])
}

// ==========================================
// 3. Marketing: Banners, Deals, Coupons
// ==========================================

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String
  ctaText   String
  href      String
  imageUrl  String
  gradient  String?
  textColor String   @default("#ffffff")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DealOfTheDay {
  id             String   @id @default(uuid())
  title          String
  subtitle       String
  endTime        DateTime
  productIds     String[]
  bannerGradient String?
  isActive       Boolean  @default(true)
}

model BankOffer {
  id                  String   @id @default(uuid())
  bank                String
  title               String
  description         String
  code                String?
  minCartValueInPaise Int      @default(0)
  maxDiscountInPaise  Int      @default(0)
  validTill           DateTime
  isActive            Boolean  @default(true)
}

model Coupon {
  id                   String    @id @default(uuid())
  code                 String    @unique
  type                 String    // percent | flat
  valueInPaise         Int       // flat paise or percentage integer
  minCartValueInPaise  Int       @default(0)
  maxDiscountInPaise   Int?
  firstOrderOnly       Boolean   @default(false)
  categoryRestriction String[]
  brandRestriction    String[]
  description          String
  expiresAt            DateTime
  isActive             Boolean   @default(true)
  usageCount           Int       @default(0)
  maxUsageLimit        Int?
  createdAt            DateTime  @default(now())

  orders Order[]

  @@index([code])
}

// ==========================================
// 4. Cart & Wishlist
// ==========================================

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String         @id @default(uuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// ==========================================
// 5. Orders, State Machine & Inventory
// ==========================================

model Order {
  id                   String      @id // Format: SB-892419
  idempotencyKey       String?     @unique
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  
  addressId            String
  shippingAddress      Address     @relation(fields: [addressId], references: [id])
  
  status               OrderStatus @default(PLACED)
  
  // All monetary fields in paise:
  itemsSubtotalInPaise Int
  productDiscountInPaise Int
  couponDiscountInPaise  Int       @default(0)
  couponId             String?
  coupon               Coupon?     @relation(fields: [couponId], references: [id])
  
  deliveryFeeInPaise   Int         @default(0)
  codFeeInPaise        Int         @default(0)
  walletDeductionInPaise Int       @default(0)
  pointsDeductionInPaise Int       @default(0)
  totalInPaise         Int
  gstIncludedInPaise   Int

  carrierName          String?     // Blue Dart, Delhivery
  trackingNumber       String?
  estimatedDeliveryDate DateTime?

  cancellationReason   String?
  cancellationDate     DateTime?

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items                OrderItem[]
  events               OrderEvent[]
  payments             Payment[]
  returns              ReturnRequest[]
  reservations         InventoryReservation[]

  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
}

model OrderItem {
  id                  String         @id @default(uuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product        @relation(fields: [productId], references: [id])
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  
  title               String
  brand               String
  size                String
  color               String
  quantity            Int
  
  mrpInPaise          Int
  priceInPaise        Int
  discountInPaise     Int            @default(0)
  taxInPaise          Int            @default(0)
  imageUrl            String?

  returnItem          ReturnItem?

  @@index([orderId])
}

model OrderEvent {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  message     String
  location    String?
  actorId     String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model InventoryReservation {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  expiresAt  DateTime
  isReleased Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([variantId])
  @@index([expiresAt])
}

// ==========================================
// 6. Payments & Payment Events (Gateway Ready)
// ==========================================

model Payment {
  id             String              @id @default(uuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       PaymentProviderType @default(COD)
  providerRef    String?             // Gateway order_id or COD reference
  status         PaymentStatus       @default(COD_PENDING)
  amountInPaise  Int
  currency       String              @default("INR")
  paymentMethod  String              // "COD", "UPI", "CARD", "WALLET"
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  events         PaymentEvent[]

  @@index([orderId])
  @@index([providerRef])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType   String   // "COD_CREATED", "COD_COLLECTED", "WEBHOOK_SUCCESS"
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

// ==========================================
// 7. Wallet, Loyalty & Gift Cards (Ledgers)
// ==========================================

model WalletLedgerEntry {
  id                  String           @id @default(uuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                WalletLedgerType
  amountInPaise       Int
  balanceAfterInPaise Int
  source              String           // "ORDER_REFUND", "GIFT_CARD", "ADMIN_CREDIT", "ORDER_PAYMENT"
  referenceId         String?          // Order ID or Gift Card ID
  description         String
  createdAt           DateTime         @default(now())

  @@index([userId])
}

model LoyaltyLedgerEntry {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  points             Int
  balanceAfterPoints Int
  source             String           // "EARNED_ORDER", "REDEEMED_ORDER"
  referenceId        String?
  createdAt          DateTime         @default(now())

  @@index([userId])
}

model GiftCard {
  id               String    @id @default(uuid())
  codeHash         String    @unique
  pinHash          String
  initialInPaise   Int
  balanceInPaise   Int
  isRedeemed       Boolean   @default(false)
  redeemedByUserId String?
  redeemedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([codeHash])
}

// ==========================================
// 8. Returns, Exchanges & Reviews
// ==========================================

model ReturnRequest {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  type           ReturnType   @default(REFUND)
  status         ReturnStatus @default(REQUESTED)
  reason         String
  condition      String?
  pickupAddress  String
  pickupDate     DateTime?
  refundMethod   String       @default("WALLET") // WALLET | BANK_TRANSFER
  refundRef      String?      // Manual bank transfer reference
  adminNotes     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items          ReturnItem[]

  @@index([orderId])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String        @unique
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  exchangeSize    String?
}

model Review {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String
  rating          Int      // 1 to 5
  title           String
  comment         String
  fit             String?  // "Runs Small", "True to Size", "Runs Large"
  photos          String[]
  isVerifiedBuyer Boolean  @default(true)
  isApproved      Boolean  @default(true)
  helpfulCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  votes           ReviewHelpfulVote[]

  @@unique([userId, productId, orderId])
  @@index([productId])
}

model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // "STATUS_CHANGE", "COD_COLLECTED", "COD_BLOCKED"
  entityType String   // "ORDER", "USER", "RETURN"
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
